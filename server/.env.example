# Server environment reference. Copy to .env and fill in real values.
# The server runs fine without most of these; SMTP is used only for notifications.

PORT=4000

# MongoDB connection string (Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ems

# JWT secrets - use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# NODE_ENV=production enables secure HttpOnly refresh cookies (HTTPS only)

# Display name shown in the sidebar for the admin account (defaults to "Administrator")
ADMIN_NAME=

# SMTP for notification emails (Brevo/any SMTP relay)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Inngest (scheduled checkout, leave reminders) - optional local dev key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=